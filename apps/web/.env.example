# Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_…) — публичный, его можно держать во фронтенде
VITE_SUPABASE_PUBLISHABLE_KEY=
# Google Cloud → APIs & Services → Credentials → OAuth client (Web). Необязательно: по умолчанию клиент «Грош Web»
VITE_GOOGLE_CLIENT_ID=
